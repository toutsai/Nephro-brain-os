# NB Insight Crawler v2 - 環境變數設定
# 複製此檔案為 .env 並填入你的 API key

# Firebase 憑證（二選一）
# 方式 1：指向 JSON 檔案路徑
FIREBASE_SERVICE_ACCOUNT_JSON=serviceAccountKey.json
# 方式 2：直接貼 JSON 內容（適合 Cloud Run 部署）
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"nephro-brain",...}

# Gemini API Key（Level 1-2 高證據文獻）
# 從 https://aistudio.google.com/apikey 取得
GOOGLE_API_KEY=your-google-api-key

# Groq API Key（Level 3-5 + fallback）
# 從 https://console.groq.com/keys 取得
GROQ_API_KEY=your-groq-api-key

# 每日 Email 摘要（crawlers/send_daily_digest.py）
# 寄件 Gmail 帳號（需開啟兩步驟驗證）
GMAIL_ADDRESS=your-gmail-address@gmail.com
# Gmail 兩步驟驗證後於 myaccount.google.com/apppasswords 產生的 16 碼 App Password
GMAIL_APP_PASSWORD=your-16-char-app-password
# （選填）收件信箱，未設定則預設同 GMAIL_ADDRESS
DIGEST_TO_EMAIL=your-gmail-address@gmail.com
