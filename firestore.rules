rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 使用者 profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // 只能透過 Admin SDK（後端）寫入
    }

    // 個人資料 — 只能讀寫自己的
    match /chats/{chatId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
      }
    }

    match /notes/{noteId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /teach_sessions/{sessionId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /assist_history/{historyId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /insight_collection/{collectionId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // 公開資料 — 所有已登入使用者可讀
    match /articles_v2/{articleId} {
      allow read: if request.auth != null;
    }

    match /articles_unified/{articleId} {
      allow read: if request.auth != null;
    }

    match /books/{bookId} {
      allow read: if request.auth != null;
    }

    match /token_usage/{docId} {
      allow read: if request.auth != null;
    }
  }
}
