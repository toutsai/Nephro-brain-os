rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 使用者 profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // 只能透過 Admin SDK（後端）寫入
    }

    // 個人資料 — 只能讀寫自己的
    match /chats/{chatId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
      }
    }

    match /notes/{noteId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /teach_sessions/{sessionId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /assist_history/{historyId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /insight_collection/{collectionId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // 精選問答 — 登入者可讀可建立，只能刪除/改自己的
    match /featured_qna/{qnaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // 公開資料 — 任何人可讀（不需登入）
    match /articles_v2/{articleId} {
      allow read: if true;
    }

    match /articles_unified/{articleId} {
      allow read: if true;
    }

    match /books/{bookId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /token_usage/{docId} {
      allow read: if true;
    }

    // 臨床指引目錄 — 公開讀取
    match /guidelines/{guidelineId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 指引章節內容 — 公開讀取
    match /guideline_chapters/{chapterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 臨床試驗 — 公開讀取
    match /clinical_trials/{trialId} {
      allow read: if true;
    }

    // 知識圖譜 — 概念與連結（公開讀取，登入者可寫）
    match /kg_concepts/{conceptId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /kg_links/{linkId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 知識圖譜 — 跨文獻洞見（AI 產出，僅後端寫入，前端唯讀）
    match /kg_insights/{insightId} {
      allow read: if true;
    }

    // 知識圖譜 — 指引更新旗標（AI 產出，僅後端寫入，前端唯讀）
    match /kg_guideline_flags/{flagId} {
      allow read: if true;
    }

    // 知識圖譜 — Consult 萃取（僅後端寫入，本人可讀）
    match /kg_consult_extractions/{extractionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 知識圖譜 — 缺口報告（登入者可讀）
    match /kg_gap_reports/{reportId} {
      allow read: if request.auth != null;
    }

    // 系統設定（含 OE cookies）— 僅 admin 可讀寫
    match /system_config/{doc} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
